# cola configuration
# Copy to cola.toml and fill in your values. cola.toml is gitignored because
# it holds your real Feishu app secret.

[opencode]
# The OpenCode server cola talks to. cola discovers a running server on the
# default store and rewrites this URL automatically (see README); this value is
# the fallback / preferred port when none is running (cola starts its own).
url = "http://localhost:4096"
# username and password are optional (for basic auth). cola discovers both from
# the running OpenCode server automatically (password + username from its env,
# defaulting to "opencode"); only set them here to override that.
# username = "opencode"
# password = ""
# Model cola's own sessions use by default. It must exist on the server cola
# attaches to. Optional: when unset (or removed), cola does NOT pin a model and
# the OpenCode server uses ITS default model — so on most setups you can just
# delete this line.
# model = "opencode/deepseek-v4-flash"

[feishu]
# Your Feishu custom app's credentials. Create one at
# https://open.feishu.cn/app, enable the "im:message" / "im:message:send_as_bot"
# scopes, and grant the bot the needed permissions.
app_id = "cli_xxxxxxxxxxxx"
app_secret = "your-app-secret"

[bridge]
# Path to the session mapping file (chat thread <-> OpenCode session).
# session_file = "~/.cola/sessions.json"
# Default directory for new sessions (instead of cola's working directory).
# `/dir` still overrides per session. Leave unset to fall back to the cwd.
# work_dir = "/path/to/a/project"
# In group chats, reply to the requester's message with a short completion
# notice (the streaming card is patched in place, so it does not push a new
# notification). Set false to disable.
# group_completion_notice = true