# cola configuration
# Copy to cola.toml and fill in your values. cola.toml is gitignored because
# it holds your real Feishu app secret.
#
# The ONLY required values are the Feishu credentials below. Everything else
# is optional.

[opencode]
# Preferred/fallback port for the OpenCode server. cola discovers a running
# server on the default store and attaches to it automatically; this value is
# only the preferred port (and the fallback when none is running, cola starts
# its own on http://localhost:4096). Optional.
# url = "http://localhost:4096"
# When cola may start its own `opencode serve` (ADR-0013):
#   auto  — Lazy Start (default): attach at boot, spawn an own server only at
#           the moment a prompt needs one and none is running.
#   never — attach-only: never spawn. If no server exists, cola replies that
#           OpenCode is unavailable.
#   eager — the old behavior: spawn an own server at boot when none is running.
# start_server = "auto"
# Model cola's own sessions use by default. It must exist on the server cola
# attaches to. Optional: when unset (or removed), cola does NOT pin a model and
# the OpenCode server uses ITS default model — so on most setups you can just
# delete this line.
# model = "opencode/deepseek-v4-flash"

[feishu]
# Your Feishu custom app's credentials. Create one at
# https://open.feishu.cn/app, enable the "im:message" / "im:message:send_as_bot"
# scopes, and grant the bot the needed permissions.
app_id = "cli_xxxxxxxxxxxx"
app_secret = "your-app-secret"

[bridge]
# Path to the session mapping file (chat thread <-> OpenCode session).
# session_file = "~/.cola/sessions.json"
# Default directory for new sessions when the conversation has no active
# session (a fresh chat, or after /forget). Leave unset to fall back to the
# cwd. /new inherits the active session's directory; /dir still overrides
# per session.
# work_dir = "/path/to/a/project"
# In group chats, reply to the requester's message with a short completion
# notice (the streaming card is patched in place, so it does not push a new
# notification). Set false to disable.
# group_completion_notice = true
# How many days of rotated daily logs to keep (default 14).
# log_days = 14