{
  "$schema": "https://opencode.ai/config.json",
  // ── Pipeline model switch ────────────────────────────────────────────
  // The models the /implement-spec sub-agents run on. Keep both entries below
  // together: authors and the merger share the main model, while the review
  // pair runs on the cheaper reviewer. Change these values (one place) to move
  // the pipeline to another provider/model — e.g. when a quota runs out.
  "agents": {
    "implementer": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "merger": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "code-reviewer": {
      "model": "opencode-go/glm-5.3-flash#high"
    }
  }
}
